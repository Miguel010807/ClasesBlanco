{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "strictNullChecks": true,
	"ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@layouts/*": ["src/layouts/*"],
      "@config/*": ["src/config/*"],
      "@content/*": ["src/content/*"],
      "@components/*": ["src/components/*"],
      "@utils/*": ["src/utils/*"],
      "@styles/*": ["src/styles/*"],
      "@motor/*": ["src/motor/*"],
      "@cuerpos/*": ["src/cuerpos/*"],
      "@colores/*": ["src/colores/*"]
    }
  }
}